CAREERPATH_SECRET_KEY=replace-with-a-long-random-secret
CAREERPATH_SMTP_HOST=smtp.example.com
CAREERPATH_SMTP_PORT=587
CAREERPATH_SMTP_USERNAME=your-email@example.com
CAREERPATH_SMTP_PASSWORD=your-smtp-password-or-app-password
CAREERPATH_SMTP_FROM=CareerPath AI <your-email@example.com>
# Local-only fallback: writes OTPs to instance/dev-mail.log when set to 1.
# Keep 0 for real SMTP delivery and never enable this in production.
CAREERPATH_DEV_EMAIL=0
